# =============================================
# PURVAJ 2.0 - Production Environment Variables
# =============================================
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit the .env file to source control.

# =============================================
# SERVER CONFIGURATION
# =============================================
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# =============================================
# SECURITY & TOKENS (CRITICAL — MUST CHANGE IN PRODUCTION)
# =============================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_STRONG_RANDOM_SECRET

# =============================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase)
# =============================================
DATABASE_URL=postgresql://user:password@host:5432/database_name
DATABASE_SSL=true

# Fallback individual DB config (used when DATABASE_URL is not set)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_DATABASE=purvaj_db

# =============================================
# CENTRAL WAREHOUSE IDENTITY (Single Warehouse Architecture)
# =============================================
WAREHOUSE_ID=PURVAJ_CENTRAL_01
WAREHOUSE_NAME="Purvaj Main Central Warehouse"

# =============================================
# PAYMENT GATEWAY CONFIGURATION
# Options for PAYMENT_GATEWAY_PROVIDER: 'sandbox' | 'razorpay'
# =============================================
PAYMENT_GATEWAY_PROVIDER=sandbox
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# =============================================
# WHATSAPP BUSINESS CLOUD API CONFIGURATION
# Options for WHATSAPP_PROVIDER: 'sandbox' | 'meta'
# =============================================
WHATSAPP_PROVIDER=sandbox
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# =============================================
# SMS GATEWAY CONFIGURATION (MSG91 / FAST2SMS)
# Options for SMS_PROVIDER: 'sandbox' | 'msg91'
# =============================================
SMS_PROVIDER=sandbox
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=PURVAJ
MSG91_FLOW_ID=your_msg91_approved_flow_id

# =============================================
# BACKUP CONFIGURATION (Optional)
# =============================================
# BACKUP_S3_BUCKET=your-backup-bucket
# BACKUP_S3_REGION=ap-south-1
# BACKUP_SCHEDULE=0 2 * * *
