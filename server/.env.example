# PURVAJ 2.0 - Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Security & Tokens
JWT_SECRET=purvaj_wholesale_jwt_production_secret_key_2026

# PostgreSQL / Supabase Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/purvaj_db
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=purvaj_db
DATABASE_SSL=false

# Central Warehouse Identity (Single Warehouse Architecture)
WAREHOUSE_ID=PURVAJ_CENTRAL_01
WAREHOUSE_NAME="Purvaj Main Central Warehouse"

# ========================================================
# PAYMENT GATEWAY CONFIGURATION
# Options for PAYMENT_GATEWAY_PROVIDER: 'sandbox' | 'razorpay'
# ========================================================
PAYMENT_GATEWAY_PROVIDER=sandbox
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ========================================================
# WHATSAPP BUSINESS CLOUD API CONFIGURATION
# Options for WHATSAPP_PROVIDER: 'sandbox' | 'meta'
# ========================================================
WHATSAPP_PROVIDER=sandbox
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# ========================================================
# SMS GATEWAY CONFIGURATION (MSG91 / FAST2SMS)
# Options for SMS_PROVIDER: 'sandbox' | 'msg91'
# ========================================================
SMS_PROVIDER=sandbox
SMS_API_KEY=your_sms_provider_api_key
SMS_SENDER_ID=PURVAJ
MSG91_FLOW_ID=your_msg91_approved_flow_id

